# 운영체제 및 편집기 로컬 파일
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
/.history/

# KiCad 사용자 설정, 잠금 및 자동 백업
*.kicad_prl
~*.lck
*.kicad_pcb.lck
*.kicad_sch.lck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*.brd-bak
*.bak
*.bck
*-backups/
_autosave-*
fp-info-cache
/backups/
/tmp/
/en/freerouting.log

# Python 가상환경 및 캐시
.venv/
.pi-venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# 로컬 환경 변수 (공유용 예제는 유지)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 펌웨어 빌드 결과 (firmware/.gitignore 와 같은 규칙)
/firmware/.deps/
/firmware/build*/
/firmware/cmake-build-*/
/firmware/build*.log

# KiCad 원본(.kicad_pro/.kicad_sch/.kicad_pcb), 라이브러리, 문서(docs/), 도구(tools/)는 추적 대상

# 참고 자료 원본 — 저장소에는 링크만 남긴다 (assets/README.md)
assets/datasheets/
assets/upstream/
assets/pcba-passives/*.pdf
